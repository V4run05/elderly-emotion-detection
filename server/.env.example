# Copy to server/.env and fill in. server/.env is gitignored -- never commit real keys.

# Required: free key from https://console.groq.com (speech-to-text + companion replies)
GROQ_API_KEY=your-groq-api-key-here

# Names used in conversation and on the family dashboard
ELDER_NAME=Lakshmi
COMPANION_NAME=Asha

# Optional overrides (defaults shown) -- see server/app/config.py for everything tunable
# LLM_MODEL=openai/gpt-oss-20b
# STT_MODEL=whisper-large-v3
# TTS_PROVIDER=edge                     # edge | orpheus (accept terms in Groq console first) | gtts
# TTS_EDGE_VOICE=en-IN-NeerjaNeural     # or en-IN-NeerjaExpressiveNeural, en-IN-PrabhatNeural
# TTS_EDGE_RATE=+0%                     # e.g. +10% faster, -10% slower
# TTS_ORPHEUS_VOICE=hannah              # autumn | diana | hannah | austin | daniel | troy
# MAX_TURNS_PER_SESSION=3
# KEEP_MEDIA=false
